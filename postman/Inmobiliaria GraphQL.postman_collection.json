						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Auth | Register -> 200\", () => {",
									"    pm.response.to.have.status(200);",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('register');",
									"    pm.expect(jsonData.data.register).to.have.property('token');",
									"    pm.expect(jsonData.data.register.user).to.have.property('email');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    token\n    user {\n      id\n      name\n      email\n      role\n      createdAt\n    }\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"name\": \"Agente 007\",\n    \"email\": \"james.bond@icesi.edu\",\n    \"password\": \"shaken_not_stirred\"\n  }\n}"
