									"pm.test(\"Create property (agent primary) -> 201\", () => {\r",
									"  pm.response.to.have.status(201);\r",
									"  const property = pm.response.json();\r",
									"  pm.expect(property).to.have.property(\"id\");\r",
									"  pm.expect(property).to.have.property(\"ownerId\");\r",
									"  const testAgentId = pm.collectionVariables.get(\"test_agent_id\");\r",
									"  if (testAgentId) {\r",
									"    pm.expect(property.ownerId).to.eql(testAgentId);\r",
									"  }\r",
									"  pm.collectionVariables.set(\"test_property_id\", property.id);\r",
									"  pm.collectionVariables.set(\"test_property_owner_id\", property.ownerId);\r",
									"});\r",
									""
