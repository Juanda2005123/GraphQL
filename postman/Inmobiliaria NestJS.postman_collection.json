				{
					"name": "Users | Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Este script se ejecuta DESPUÉS de recibir la respuesta del login.\r",
									"pm.test(\"Users | Login -> stores agent token\", function () {",
									"    pm.response.to.have.status(200);",
									"    // Convierte la respuesta JSON en un objeto JavaScript.\r",
									"    const jsonData = pm.response.json();\r",
									"\r",
									"    // Si el objeto de respuesta existe y tiene una propiedad \"token\"...\r",
									"    if (jsonData && jsonData.token) {\r",
									"        // ...guárdala en una VARIABLE DE COLECCIÓN llamada \"jwt_token\".\r",
									"        pm.collectionVariables.set(\"jwt_token\", jsonData.token);\r",
									"        pm.globals.set(\"jwt_token\", jsonData.token);\r",
									"        pm.environment.set(\"jwt_token\", jsonData.token);\r",
									"        console.log(\"Token JWT guardado en las variables de la colección.\");\r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
