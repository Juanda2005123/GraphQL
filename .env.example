# Configuración de la Base de Datos (Desarrollo Local)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_db

# Configuración de la Base de Datos (Producción - Render)
# DATABASE_URL=postgresql://user:password@host:port/database
# (Render provee esta variable automáticamente cuando agregas PostgreSQL)

# JWT Secret (IMPORTANTE: Cambiar en producción)
JWT_SECRET=tu_secreto_super_seguro_para_produccion_cambiar_esto

# Node Environment
NODE_ENV=development

# Puerto de la aplicación
PORT=3001
